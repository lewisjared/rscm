# MAGICC v7.5.3 distribution for regression data generation.
# Defaults to ~/.local/share/magicc/magicc-v7.5.3, so set this only to use another copy.
MAGICC_ROOT=/path/to/magicc-v7.5.3
# AR6 600-member probabilistic distribution.
# Defaults to the drawnset JSON in ~/.local/share/magicc/magicc-ar6-0fd0f62-f023edb-drawnset.
MAGICC_AR6_CONFIG=/path/to/0fd0f62-derived-metrics-id-f023edb-drawnset.json
